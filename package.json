{
    "name": "spa-tarja",
    "private": true,
    "version": "1.10.0",
    "license": "UNLICENSED",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "types:gen": "wrangler types",
        "types:check": "tsc -b",
        "lint": "eslint . && stylelint \"src/**/*.css\" \"design-system/stories/**/*.css\"",
        "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" \"design-system/stories/**/*.css\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "pnpm --filter design-system storybook",
        "deploy:storybook": "pnpm --filter design-system build && wrangler deploy --config design-system/wrangler.jsonc",
        "pwa:icons": "pwa-assets-generator",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:migrate:prerelease": "wrangler d1 migrations apply DB --remote --env prerelease",
        "deploy:prod": "pnpm build && wrangler deploy",
        "deploy:prerelease": "CLOUDFLARE_ENV=prerelease pnpm build && pnpm db:migrate:prerelease && wrangler deploy --env prerelease",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@hono/standard-validator": "0.4.1",
        "@standard-schema/spec": "1.1.0",
        "@tanstack/react-query": "5.108.4",
        "@tanstack/react-query-persist-client": "5.108.4",
        "@tanstack/react-router": "1.170.46",
        "better-auth": "1.7.28",
        "clsx": "2.1.1",
        "hono": "4.13.22",
        "idb-keyval": "6.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "use-intl": "4.15.1",
        "valibot": "1.5.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.70.2",
        "@cloudflare/vitest-plugin": "1.9.2",
        "@eslint/js": "10.0.1",
        "@tanstack/router-plugin": "1.169.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.10",
        "@types/react": "19.3.3",
        "@types/react-dom": "19.3.0",
        "@vite-pwa/assets-generator": "2.0.0",
        "@vitejs/plugin-react": "6.3.0",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.18.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.8",
        "globals": "17.14.0",
        "husky": "9.1.7",
        "jsdom": "31.0.1",
        "prettier": "3.10.1",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-order": "9.0.0",
        "stylelint-selector-bem-pattern": "5.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.74.0",
        "vite": "8.3.8",
        "vite-plugin-pwa": "2.0.0",
        "vitest": "5.1.2",
        "workbox-build": "7.4.1",
        "workbox-window": "7.4.1",
        "wrangler": "4.168.0"
    }
}
