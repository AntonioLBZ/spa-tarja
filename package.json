{
    "name": "spa-tarja",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "types:gen": "wrangler types",
        "types:check": "tsc -b",
        "lint": "eslint . && stylelint \"src/**/*.css\"",
        "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:migrate": "wrangler d1 migrations apply DB --local"
    },
    "dependencies": {
        "@tanstack/react-query": "5.104.5",
        "@tanstack/react-router": "1.170.46",
        "clsx": "2.1.1",
        "hono": "4.13.13",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "use-intl": "4.14.9"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.65.0",
        "@cloudflare/vitest-plugin": "1.4.7",
        "@eslint/js": "9.39.5",
        "@tanstack/router-plugin": "1.168.48",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "prettier": "3.9.10",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-order": "8.1.2",
        "stylelint-selector-bem-pattern": "5.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "wrangler": "4.152.0"
    }
}
