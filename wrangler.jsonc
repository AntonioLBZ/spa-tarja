{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "tarja",
    "main": "server/index.ts",
    "compatibility_date": "2026-10-19",
    "compatibility_flags": ["nodejs_als"],
    "workers_dev": false,
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "tarja",
            "database_id": "5d0422c9-c0bf-431b-8fdf-3583fee20f21",
            "migrations_dir": "db/migrations",
        },
    ],
    "observability": { "enabled": true },
    "env": {
        "prerelease": {
            "workers_dev": false,
            "routes": [{ "pattern": "tarja-prerelease.albz.app", "custom_domain": true }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "tarja-prerelease",
                    "database_id": "48700b9c-9f40-4485-869c-11fe710d4cfc",
                    "migrations_dir": "db/migrations",
                },
            ],
        },
    },
}
