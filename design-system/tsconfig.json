{
    "compilerOptions": {
        "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.design-system.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["../src/*"],
            "@core/*": ["../core/*"],
            "@server/*": ["../server/*"]
        }
    },
    // Not just ".storybook": Vite resolves the paths of a file only if the include matches it, and a bare dot folder is skipped
    "include": [".storybook/**/*", "stories", "../worker-configuration.d.ts", "../server/secrets.d.ts"]
}
